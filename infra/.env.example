# Compose 与镜像
COMPOSE_PROJECT_NAME=waimai-cps
BACKEND_IMAGE=waimai-cps-backend:local
ADMIN_WEB_IMAGE=waimai-cps-admin-web:local
TZ=Asia/Shanghai
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0

# 唯一对宿主机发布的端口；生产环境建议仅绑定 127.0.0.1，由外部 TLS 反向代理接入
ADMIN_WEB_BIND_ADDRESS=127.0.0.1
ADMIN_WEB_PORT=8080
VITE_API_BASE_URL=/api/v1/admin

# MySQL（仅容器内部网络可达）
MYSQL_DATABASE=waimai_cps
MYSQL_USER=waimai
MYSQL_PASSWORD=replace_with_a_strong_random_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_strong_random_root_password

# Redis（仅容器内部网络可达）
REDIS_PASSWORD=replace_with_a_strong_random_redis_password

# 后端必填密钥
# SESSION_TOKEN_PEPPER：至少 32 个随机字符
SESSION_TOKEN_PEPPER=replace_with_at_least_32_random_characters
# 以下两项：分别生成独立的 32 字节随机值并进行 Base64 编码
DATA_ENCRYPTION_KEY=replace_with_base64_encoded_32_random_bytes
AFFILIATE_SECRET_KEY=replace_with_another_base64_encoded_32_random_bytes
DEFAULT_TENANT_CODE=replace_with_production_tenant_code

# 微信与联盟集成；无正式凭据时留空，禁止将真实值提交到版本库
WECHAT_APP_ID=
WECHAT_APP_SECRET=
AFFILIATE_SYNC_ENABLED=true
AFFILIATE_SYNC_FIXED_DELAY_MS=300000
