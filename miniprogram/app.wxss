page{background:#f6f6f2;color:#272b27;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page{padding:28rpx}.card{background:#fff;border-radius:22rpx;padding:28rpx;margin-bottom:22rpx;box-shadow:0 8rpx 32rpx rgba(43,49,42,.06)}.primary{background:#d84b35;color:#fff;border-radius:999rpx}.muted{color:#858c85;font-size:26rpx}.title{font-size:38rpx;font-weight:700}.skeleton{height:180rpx;border-radius:20rpx;background:linear-gradient(90deg,#eceee9 25%,#f7f8f5 37%,#eceee9 63%);background-size:400% 100%;animation:shimmer 1.4s infinite}@keyframes shimmer{0%{background-position:100% 0}100%{background-position:0 0}}.state{text-align:center;padding:100rpx 30rpx;color:#858c85}.amount{font-size:54rpx;font-weight:700;color:#d84b35}.row{display:flex;align-items:center;justify-content:space-between}.platform{display:flex;gap:18rpx}.platform-card{flex:1;text-align:center;padding:30rpx 10rpx;border-radius:22rpx;background:#fff}.platform-card image{width:92rpx;height:92rpx}.field-label{margin:24rpx 0 10rpx;color:#596159;font-size:26rpx}input{box-sizing:border-box;width:100%;padding:22rpx 24rpx;margin-bottom:22rpx;border:1rpx solid #d9ddd7;border-radius:16rpx;background:#fafbf9}.error-message{margin-top:20rpx;color:#c7392f}.debt-warning{margin-top:22rpx;padding:18rpx;border-radius:14rpx;background:#fff0eb;color:#a83b2c;font-size:25rpx}.section-title{margin:28rpx 0 16rpx;font-weight:700}.order-no{margin:18rpx 0;font-size:27rpx;word-break:break-all}.status{color:#d84b35}
