<view class="page">
  <view class="card invite-card">
    <view class="title">邀请好友</view>
    <view class="muted">好友通过专属 scene 首次进入并登录后建立邀请关系。</view>
    <button class="primary" open-type="share">邀请好友</button>
  </view>
  <view wx:if="{{loading}}" class="skeleton"></view>
  <view wx:elif="{{errorMessage}}" class="state">{{errorMessage}}<button size="mini" bindtap="load">重试</button></view>
  <view wx:elif="{{items.length === 0}}" class="state">暂无邀请记录</view>
  <view wx:else>
    <view wx:for="{{items}}" wx:key="invited_at" class="card row">
      <view>{{item.nickname || '微信用户'}}</view><view class="muted">{{item.invited_at}}</view>
    </view>
  </view>
</view>
