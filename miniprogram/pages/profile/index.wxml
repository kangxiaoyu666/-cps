<view class="page">
  <view wx:if="{{loading}}" class="skeleton"></view>
  <view wx:elif="{{errorMessage}}" class="state">{{errorMessage}}<button size="mini" bindtap="load">重试</button></view>
  <block wx:else>
    <view class="card">
      <view class="row">
        <view><view class="title">{{profile.nickname || '微信用户'}}</view><view class="muted">邀请码：{{profile.invite_code}}</view></view>
        <navigator url="/pages/profile-edit/index">编辑资料</navigator>
      </view>
    </view>
    <navigator class="card row" url="/pages/orders/index">我的订单<text>›</text></navigator>
    <navigator class="card row" url="/pages/wallet/index">收益与钱包<text>›</text></navigator>
    <navigator class="card row" url="/pages/invitations/index">邀请记录<text>›</text></navigator>
    <navigator class="card row" url="/pages/withdrawals/index">提现申请<text>›</text></navigator>
    <navigator class="card row" url="/pages/help/index">帮助与协议<text>›</text></navigator>
  </block>
</view>
